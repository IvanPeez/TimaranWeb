# Copiar como .env (Vite sólo expone las variables que empiezan por VITE_)

# Número de WhatsApp para cotizaciones (solo dígitos, con indicativo país)
VITE_WHATSAPP_PHONE=
# Cómo se muestra el número en pantalla
VITE_WHATSAPP_DISPLAY=

# ---------------------------------------------------------------------------
# Catálogos en PDF (Blob de Vercel)
# ---------------------------------------------------------------------------
# Los PDF no van en el repositorio: pesan más de 10 MB y se reemplazan cada
# temporada. Viven en un Blob público de Vercel y aquí sólo se guarda su URL.
#
# Subirlos (una vez, con la CLI instalada y sesión iniciada):
#
#   npm i -g vercel
#   vercel login
#   vercel link                                   # enlaza esta carpeta al proyecto
#   vercel blob create-store catalogos-timaran --access public
#   vercel blob put ./catalogo-envases.pdf  --pathname catalogos/envases.pdf  --access public --allow-overwrite --cache-control-max-age 3600
#   vercel blob put ./catalogo-esencias.pdf --pathname catalogos/esencias.pdf --access public --allow-overwrite --cache-control-max-age 3600
#
# Cada `put` imprime la URL pública (https://<store>.public.blob.vercel-storage.com/...).
# Se pega aquí y también en Vercel → Settings → Environment Variables, porque
# Vite las incrusta al compilar: si faltan en el build, el catálogo sale vacío
# y hay que volver a desplegar después de agregarlas.
#
# Actualizar el catálogo: repetir el `put` sobre el mismo --pathname. La URL no
# cambia, así que no hace falta tocar estas variables ni redesplegar, pero la
# CDN sigue entregando la versión anterior hasta que vence el cache-control
# (por eso arriba se baja a 1 hora; el valor por defecto son 30 días). Si el
# cambio es urgente, subirlo con otro --pathname y actualizar la variable.

VITE_CATALOGO_ENVASES_PDF=
VITE_CATALOGO_ESENCIAS_PDF=
